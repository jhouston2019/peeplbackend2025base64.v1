rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check uses UID comparison rather than Firestore path lookup
    // because this project keys the users collection by UID string
    // (collection name = UID), not the standard /users/{uid} pattern.
    // TODO: migrate to path-based check once user document structure
    // is confirmed and isAdmin field is verified to exist.
    function isAppAdmin() {
      return request.auth != null && (
        request.auth.uid == 'CAASNAhaDbPrl0zH1yDn5qRqAtJ3'
      );
    }

    function isGrowthAdmin() {
      return request.auth != null && (
        isAppAdmin() ||
        get(/databases/$(database)/documents/CAASNAhaDbPrl0zH1yDn5qRqAtJ3/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Users: own profile, or full access for admins (moderation / admin panel)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAppAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAppAdmin());
      allow delete: if isAppAdmin();
    }

    // Canonical user profiles — collection name is the admin UID string.
    match /CAASNAhaDbPrl0zH1yDn5qRqAtJ3/{userId} {
      // Users can read and write their own document only.
      allow read, update: if request.auth != null
        && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow delete: if isAppAdmin();
      // Admin can read and update any user document.
      allow read, update: if isAppAdmin();
    }

    match /CAASNAhaDbPrl0zH1yDn5qRqAtJ3/{userId}/following/{followId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }

    match /CAASNAhaDbPrl0zH1yDn5qRqAtJ3/{userId}/followers/{followId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if request.auth != null
        && request.auth.uid == followId;
      allow update: if false;
    }

    match /CAASNAhaDbPrl0zH1yDn5qRqAtJ3/{userId}/groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Location posts (feed). Likes update likesCount on any post (not only owner).
    match /location_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isAppAdmin() ||
        resource.data.userId == request.auth.uid ||
        (
          resource.data.userId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['helpedCount'])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAppAdmin());
    }

    match /location_posts/{postId}/likes/{likeUserId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == likeUserId;
    }

    // Native ads (feed + admin toggle)
    match /native_ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAppAdmin();
    }
    
    // Venues are publicly readable, only authenticated users can create
    match /venues/{venueId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (resource.data.createdBy == request.auth.uid || 
         request.auth.token.admin == true);
    }
    
    // Peeps are publicly readable, only authenticated users can create
    match /peeps/{peepId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // User locations are private
    match /user_locations/{userId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // Geofence events are private
    match /geofence_events/{eventId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Device tokens are private
    match /device_tokens/{tokenId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Likes
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Peep history (read-only)
    match /peep_history/{historyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Merchant accounts (doc id is not the owner UID; match ownerId from Task 2 / Task 57)
    match /merchant_accounts/{merchantId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Merchant ads (Task 2 / Task 57)
    match /merchant_ads/{adId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Points (read-only for users)
    match /points/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Groups
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // TestFlight diagnostic logs — authenticated write, admin-only read.
    // TODO: gate behind remote config or remove before public launch.
    match /debug_logs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['tag', 'message', 'timestamp'])
        && request.resource.data.tag is string
        && request.resource.data.message is string;
      allow read: if request.auth.uid == 'CAASNAhaDbPrl0zH1yDn5qRqAtJ3';
      allow update, delete: if false;
    }

    match /crowdsource_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource.data.requestedBy == request.auth.uid ||
         isGrowthAdmin());
      allow update: if request.auth != null &&
        isGrowthAdmin();
    }

    match /crowdsource_responses/{responseId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        resource.data.requesterId == request.auth.uid;
    }

    // AI config — key set manually in Firebase console; read by authenticated clients.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /venue_intelligence/{venueKey} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /venue_intelligence/{venueKey}/crowd_history/{entry} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    match /crowd_anomalies/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Geofence venue registry — public read for client geofencing.
    match /locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/CAASNAhaDbPrl0zH1yDn5qRqAtJ3/$(request.auth.uid)).data.isAdmin == true;
      allow create, update: if request.auth != null;
    }

    // Growth funnel analytics (Phase 1).
    match /growth_events/{eventId} {
      allow write: if request.auth != null;
      allow read: if isGrowthAdmin();
    }

    // Per-post / venue share tracking (Phase 2).
    match /peep_shares/{shareId} {
      allow create: if request.auth != null
        && request.resource.data.sharingUserId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.sharingUserId == request.auth.uid;
    }

    // Share link opens — written by Railway backend (Admin SDK) only.
    match /peep_link_opens/{openId} {
      allow read, write: if false;
    }

    // Saved location alerts (Phase 6).
    match /location_follows/{followId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /venue_comparisons/{groupId} {
      allow create: if request.auth != null;
      allow read: if true;
    }

    match /social_share_cards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null &&
        isGrowthAdmin();
    }

    match /venue_entry_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
