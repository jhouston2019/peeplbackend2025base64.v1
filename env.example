# Peepl 2025 Backend Configuration
# Copy this file to .env and fill in your actual values

# Firebase Configuration
FIREBASE_CONFIG_B64=your_base64_encoded_firebase_service_account_key_here
FIREBASE_STORAGE_BUCKET=peepl-2025.appspot.com
FIREBASE_PROJECT_ID=peepl-2025

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Yelp API (Optional - for venue discovery)
YELP_API_KEY=your_yelp_api_key_here

# Push Notifications
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://yourdomain.com

# Logging
LOG_LEVEL=info

# Database Configuration
DB_TIMEOUT=30000
DB_MAX_CONNECTIONS=10

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Geofencing Configuration
GEOFENCE_RADIUS=100
GEOFENCE_CHECK_INTERVAL=30000

# Notification Configuration
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_RETRY_ATTEMPTS=3

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Development
DEBUG_MODE=false
VERBOSE_LOGGING=false