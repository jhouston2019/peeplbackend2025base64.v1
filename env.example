# Peepl 2025 Backend Configuration
# Copy this file to .env and fill in your actual values.
#
# --- Staging vs production ---
# Use staging Firebase / Stripe test keys locally and in CI for non-prod.
# Production: point FIREBASE_* and secrets at the production project only in prod env.

# Firebase (use staging values locally; production in prod only)
FIREBASE_PROJECT_ID=peepl-staging
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
# Service account JSON as base64 (existing backend convention)
FIREBASE_CONFIG_B64=your_base64_encoded_firebase_service_account_key_here
FIREBASE_STORAGE_BUCKET=peepl-staging.appspot.com

# Stripe (test keys for staging; live keys only in production secrets)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_VIPEEPS_PRICE_ID=price_your_id_here

# Sentry (error monitoring)
SENTRY_DSN=https://your_sentry_dsn_here@o000000.ingest.sentry.io/0000000

# App
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Yelp API (Optional - for venue discovery)
YELP_API_KEY=your_yelp_api_key_here

# Push Notifications
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://yourdomain.com

# Logging
LOG_LEVEL=info

# Database Configuration
DB_TIMEOUT=30000
DB_MAX_CONNECTIONS=10

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Geofencing Configuration
GEOFENCE_RADIUS=100
GEOFENCE_CHECK_INTERVAL=30000

# Notification Configuration
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_RETRY_ATTEMPTS=3

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Development
DEBUG_MODE=false
VERBOSE_LOGGING=false
