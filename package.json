{
  "name": "peepl-backend-2025",
  "version": "2.0.0",
  "description": "Peepl 2025 - Modern Social Location Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "production": "NODE_ENV=production node server.js",
    "test": "jest --testEnvironment=node --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "echo 'No build step required for Node.js'",
    "docker:build": "docker build -t peepl-backend-2025 .",
    "docker:run": "docker run -p 3000:3000 peepl-backend-2025",
    "db:init": "node scripts/init-database.js",
    "db:migrate": "node scripts/migrate-database.js",
    "db:backup": "node scripts/backup-database.js",
    "deploy:staging": "npm run test && npm run lint && echo 'Deploy to staging'",
    "deploy:production": "npm run test && npm run lint && echo 'Deploy to production'"
  },
  "keywords": [
    "peepl",
    "social",
    "location",
    "mobile",
    "react-native",
    "firebase",
    "nodejs",
    "express",
    "socket.io",
    "push-notifications",
    "geofencing"
  ],
  "author": "Peepl Development Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^7.120.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.10.1",
    "geofire-common": "^6.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4",
    "stripe": "^14.25.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jhouston2019/peepl2025.v1.git"
  },
  "bugs": {
    "url": "https://github.com/jhouston2019/peepl2025.v1/issues"
  },
  "homepage": "https://github.com/jhouston2019/peepl2025.v1#readme"
}
